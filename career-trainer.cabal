cabal-version:      3.8
name:               career-trainer
version:            0.1.0.0
synopsis:           Web app for career training workflows
description:        AI-assisted career training web application built with Haskell, Scotty, SQLite, OpenAI, and Nix.
category:           Web
license:            MIT
license-file:       LICENSE
author:             Antonio
maintainer:         Antonio
build-type:         Simple
extra-source-files:
    README.md
    .env.example
tested-with:        GHC ==9.12.3

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields

executable career-trainer
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: GHC2021
    build-depends:
        aeson >=2.2 && <2.3,
        base >=4.18 && <4.23,
        bytestring >=0.11 && <0.13,
        directory >=1.3 && <1.4,
        http-client >=0.7 && <0.8,
        http-client-tls >=0.3 && <0.4,
        http-types >=0.12 && <0.13,
        lucid2 >=0.0.20260427 && <0.1,
        scotty >=0.30 && <0.31,
        sqlite-simple >=0.4 && <0.5,
        text >=2.0 && <2.2,
        wai >=3.2 && <3.3,
        wai-extra >=3.1 && <3.2,
        warp >=3.4 && <3.5
